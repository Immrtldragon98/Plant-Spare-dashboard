PORT=3001
# Use the Neon pooled PostgreSQL connection string here.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
# Optional only for first-time bootstrap. Admin can also be created directly in Neon.
ADMIN_NAME=Cast House Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
