PORT=3001
# Use the Neon pooled PostgreSQL connection string here.
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-POOLER-HOST/neondb?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
# Optional only for first-time bootstrap. Admin can also be created directly in Neon.
ADMIN_NAME=Cast House Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now

# Shared OpenAI-compatible AI provider. OpenRouter can use https://openrouter.ai/api/v1.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# OpenRouter may alternatively use this key with the default OpenRouter base/model.
OPENROUTER_API_KEY=

# Legacy import-specific AI settings remain supported as fallback.
AI_IMPORT_BASE_URL=
AI_IMPORT_API_KEY=
AI_IMPORT_MODEL=

# Optional S3-compatible object storage for manuals, catalogues, drawings and images.
# Cloudflare R2 works here. Leave blank for text-only RAG indexing.
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY_ID=
OBJECT_STORAGE_SECRET_ACCESS_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_REGION=auto
# Optional public/custom-domain base URL. Leave blank for private objects.
OBJECT_STORAGE_PUBLIC_BASE_URL=
